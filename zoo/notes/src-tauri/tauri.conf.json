{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notes",
  "version": "0.1.0",
  "identifier": "dev.windtunnel.notes",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Notes", "width": 960, "height": 640 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
